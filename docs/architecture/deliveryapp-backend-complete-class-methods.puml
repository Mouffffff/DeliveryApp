@startuml

title DeliveryApp - UML Backend Complet (Architecture Actuelle)
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "API" {
  class DeliveryEndpoints {
    +MapDeliveryEndpoints(app: WebApplication): void
    -ToHttpResult<T>(result: ServiceResult<T>): IResult
  }

  class Program {
    +Main(args: string[]): void
  }

  class GlobalExceptionHandler {
    +TryHandleAsync(httpContext, exception, cancellationToken): ValueTask<bool>
  }
}

package "Application.Common" {
  class ServiceError {
    +Code: string
    +Message: string
    +StatusCode: int
  }

  class ServiceResult~T~ {
    +Value: T?
    +Error: ServiceError?
    +IsSuccess: bool
    +Success(value: T): ServiceResult<T>
    +Failure(code: string, message: string, statusCode: int): ServiceResult<T>
  }
}

package "Application.Validation" {
  class OrderValidator {
    +ValidateCreate(dto: CreateDeliveryDto): (bool ok, string error)
    +ValidateUpdate(dto: UpdateDeliveryDto): (bool ok, string error)
  }

  class PaymentValidator {
    +ValidateCreate(dto: CreatePaymentDto): (bool ok, string error)
  }

  class CustomerValidator {
    +ValidateCreateCustomer(dto: CreateCustomerDto): (bool ok, string error)
    +ValidateCreateAddress(dto: CreateAddressDto): (bool ok, string error)
  }

  class CatalogValidator {
    +ValidateCreateStore(dto: CreateStoreDto): (bool ok, string error)
    +ValidateCreateProduct(dto: CreateProductDto): (bool ok, string error)
  }

  class CourierValidator {
    +ValidateCreate(dto: CreateCourierDto): (bool ok, string error)
  }

  class ReviewValidator {
    +ValidateCreate(dto: CreateReviewDto): (bool ok, string error)
  }
}

package "Application - Services" {
  interface IOrderService {
    +GetAllAsync(): Task<IReadOnlyList<DeliveryDto>>
    +GetByIdAsync(id: int): Task<ServiceResult<DeliveryDto>>
    +GetByStatusAsync(status: int): Task<ServiceResult<IReadOnlyList<DeliveryDto>>>
    +CreateAsync(dto: CreateDeliveryDto): Task<ServiceResult<DeliveryDto>>
    +UpdateAsync(id: int, dto: UpdateDeliveryDto): Task<ServiceResult<DeliveryDto>>
    +DeleteAsync(id: int): Task<ServiceResult<bool>>
  }

  interface ICatalogService {
    +GetStoresAsync(): Task<IReadOnlyList<StoreDto>>
    +GetStoreProductsAsync(storeId: int): Task<ServiceResult<IReadOnlyList<ProductDto>>>
    +CreateStoreAsync(dto: CreateStoreDto): Task<ServiceResult<StoreDto>>
    +CreateProductAsync(dto: CreateProductDto): Task<ServiceResult<ProductDto>>
  }

  interface ICustomerService {
    +GetCustomersAsync(): Task<IReadOnlyList<CustomerDto>>
    +GetAddressesAsync(): Task<IReadOnlyList<AddressDto>>
    +CreateCustomerAsync(dto: CreateCustomerDto): Task<ServiceResult<CustomerDto>>
    +CreateAddressAsync(dto: CreateAddressDto): Task<ServiceResult<AddressDto>>
  }

  interface ICourierService {
    +GetCouriersAsync(): Task<IReadOnlyList<CourierDto>>
    +GetAvailableCouriersAsync(): Task<IReadOnlyList<CourierDto>>
    +CreateCourierAsync(dto: CreateCourierDto): Task<ServiceResult<CourierDto>>
    +AssignCourierAsync(orderId: int, courierId: int): Task<ServiceResult<DeliveryDto>>
  }

  interface IPaymentAppService {
    +CreatePaymentAsync(orderId: int, dto: CreatePaymentDto): Task<ServiceResult<PaymentDto>>
    +GetOrderPaymentsAsync(orderId: int): Task<ServiceResult<IReadOnlyList<PaymentDto>>>
  }

  interface IReviewService {
    +CreateOrderReviewAsync(orderId: int, dto: CreateReviewDto): Task<ServiceResult<ReviewDto>>
    +GetOrderReviewsAsync(orderId: int): Task<ServiceResult<IReadOnlyList<ReviewDto>>>
  }
}

package "Application - Repositories" {
  interface IOrderRepository {
    +GetAllAsync(): Task<List<Order>>
    +GetByIdAsync(id: int): Task<Order?>
    +GetByStatusAsync(status: OrderStatus): Task<List<Order>>
    +AddAsync(order: Order): Task<Order>
    +UpdateAsync(order: Order): Task<Order?>
    +DeleteAsync(id: int): Task<bool>
  }

  interface ICatalogRepository {
    +GetProductsByIdsAsync(ids: IReadOnlyCollection<int>): Task<List<Product>>
    +GetProductsByStoreIdAsync(storeId: int): Task<List<Product>>
    +GetStoresAsync(): Task<List<Store>>
    +AddStoreAsync(store: Store): Task<Store>
    +AddProductAsync(product: Product): Task<Product>
    +StoreExistsAsync(storeId: int): Task<bool>
  }

  interface ICustomerRepository {
    +GetCustomersAsync(): Task<List<Customer>>
    +GetAddressesAsync(): Task<List<Address>>
    +AddCustomerAsync(customer: Customer): Task<Customer>
    +AddAddressAsync(address: Address): Task<Address>
    +CustomerExistsAsync(customerId: int): Task<bool>
    +AddressExistsAsync(addressId: int): Task<bool>
  }

  interface ICourierRepository {
    +GetCouriersAsync(): Task<List<Courier>>
    +GetAvailableCouriersAsync(): Task<List<Courier>>
    +GetCourierByIdAsync(courierId: int): Task<Courier?>
    +SetCourierAvailabilityAsync(courierId: int, isAvailable: bool): Task
    +AddCourierAsync(courier: Courier): Task<Courier>
  }

  interface IPaymentRepository {
    +GetPaymentsByOrderIdAsync(orderId: int): Task<List<Payment>>
    +AddPaymentAsync(payment: Payment): Task<Payment>
  }

  interface IReviewRepository {
    +AddReviewAsync(review: Review): Task<Review>
    +GetReviewsByOrderIdAsync(orderId: int): Task<List<Review>>
    +ReviewExistsForOrderAsync(orderId: int): Task<bool>
  }
}

package "Services" {
  class OrderService
  class CatalogService
  class CustomerService
  class CourierService
  class PaymentAppService
  class ReviewService
  class DeliveryDtoMapper
}

package "Infrastructure" {
  class AppDbContext
  class OrderRepository
  class CatalogRepository
  class CustomerRepository
  class CourierRepository
  class PaymentRepository
  class ReviewRepository
}

package "Modules - Query/Command Abstractions" {
  interface ICatalogQueries {
    +GetStoresAsync(cancellationToken): Task<IReadOnlyList<StoreSummary>>
    +GetProductsAsync(storeId: int, cancellationToken): Task<IReadOnlyList<ProductSummary>>
  }

  interface IOrderingService {
    +PlaceOrderAsync(request: PlaceOrderRequest, cancellationToken): Task<Result<OrderDetails>>
    +GetOrderByIdAsync(orderId: int, cancellationToken): Task<Result<OrderDetails>>
  }

  interface IDispatchService {
    +AssignCourierAsync(orderId: int, courierId: int, cancellationToken): Task<Result<AssignmentDetails>>
    +GetAvailableCouriersAsync(cancellationToken): Task<Result<IReadOnlyList<CourierSummary>>>
  }

  interface IPaymentService {
    +PayOrderAsync(request: PayOrderRequest, cancellationToken): Task<Result<PaymentDetails>>
    +GetOrderPaymentsAsync(orderId: int, cancellationToken): Task<Result<IReadOnlyList<PaymentDetails>>>
  }
}

package "Domain" {
  class Order {
    +Id: int
    +OrderDate: DateTime
    +TotalPrice: decimal
    +Status: OrderStatus
    +CustomerId: int
    +StoreId: int
    +DeliveryAddressId: int
    +CourierId: int?
    +IsClosed: bool
    +SetItems(items: IEnumerable<OrderItem>): void
    +RecalculateTotal(): void
    +CanTransitionTo(next: OrderStatus): bool
    +UpdateStatus(next: OrderStatus): void
    +AssignCourier(courierId: int): void
  }

  class OrderItem {
    +Id: int
    +OrderId: int
    +ProductId: int
    +Quantity: int
    +UnitPrice: decimal
    +Create(productId: int, quantity: int, unitPrice: decimal): OrderItem
  }

  class Product {
    +Id: int
    +Name: string
    +Price: decimal
    +StoreId: int
    +Create(name: string, price: decimal, storeId: int): Product
  }

  class Store {
    +Id: int
    +Name: string
    +Category: string
    +AddressId: int
    +Create(name: string, category: string, addressId: int): Store
  }

  class Customer {
    +Id: int
    +FullName: string
    +Email: string
    +PhoneNumber: string
    +Create(fullName: string, email: string, phoneNumber: string): Customer
  }

  class Address {
    +Id: int
    +Street: string
    +City: string
    +ZipCode: string
    +CustomerId: int?
    +Create(street: string, city: string, zipCode: string, customerId: int?): Address
  }

  class Courier {
    +Id: int
    +FullName: string
    +PhoneNumber: string
    +Vehicle: VehicleType
    +IsAvailable: bool
    +SetAvailability(isAvailable: bool): void
  }

  class Payment {
    +Id: int
    +OrderId: int
    +Amount: decimal
    +PaymentDate: DateTime
    +Method: PaymentMethod
    +Status: PaymentStatus
    +CreateCompleted(orderId: int, amount: decimal, method: PaymentMethod, paymentDateUtc: DateTime): Payment
  }

  class Review {
    +Id: int
    +OrderId: int
    +Rating: int
    +Comment: string
    +CreatedAt: DateTime
    +Create(orderId: int, rating: int, comment: string, createdAtUtc: DateTime): Review
  }

  enum OrderStatus
  enum PaymentMethod
  enum PaymentStatus
  enum VehicleType
}

Program ..> AppDbContext
Program ..> IOrderRepository
Program ..> ICatalogRepository
Program ..> ICustomerRepository
Program ..> ICourierRepository
Program ..> IPaymentRepository
Program ..> IReviewRepository
Program ..> IOrderService
Program ..> ICatalogService
Program ..> ICustomerService
Program ..> ICourierService
Program ..> IPaymentAppService
Program ..> IReviewService
Program ..> ICatalogQueries
Program ..> IOrderingService
Program ..> IDispatchService
Program ..> IPaymentService

DeliveryEndpoints ..> IOrderService
DeliveryEndpoints ..> ICatalogService
DeliveryEndpoints ..> ICustomerService
DeliveryEndpoints ..> ICourierService
DeliveryEndpoints ..> IPaymentAppService
DeliveryEndpoints ..> IReviewService
DeliveryEndpoints ..> ICatalogQueries
DeliveryEndpoints ..> IOrderingService
DeliveryEndpoints ..> IDispatchService
DeliveryEndpoints ..> IPaymentService

OrderService ..|> IOrderService
CatalogService ..|> ICatalogService
CustomerService ..|> ICustomerService
CourierService ..|> ICourierService
PaymentAppService ..|> IPaymentAppService
ReviewService ..|> IReviewService

OrderService ..> IOrderRepository
OrderService ..> ICatalogRepository
OrderService ..> ICustomerRepository
OrderService ..> ICourierRepository
OrderService ..> OrderValidator
OrderService ..> DeliveryDtoMapper

CatalogService ..> ICatalogRepository
CatalogService ..> ICustomerRepository
CatalogService ..> CatalogValidator
CatalogService ..> DeliveryDtoMapper

CustomerService ..> ICustomerRepository
CustomerService ..> CustomerValidator
CustomerService ..> DeliveryDtoMapper

CourierService ..> ICourierRepository
CourierService ..> IOrderRepository
CourierService ..> CourierValidator
CourierService ..> DeliveryDtoMapper

