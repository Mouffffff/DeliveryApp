Order "1" o-- "1..*" OrderItem
OrderItem "*" --> "1" Product
Order "*" --> "1" Store
Order "*" --> "1" Customer
Order "*" --> "1" Address : DeliveryAddress
Order "*" --> "0..1" Courier
Store "*" --> "1" Address : Location
Payment "*" --> "1" Order
Review "*" --> "1" Order
Address "*" --> "0..1" Customer

Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Courier ..> VehicleType

@enduml
