@implements IDisposable
@inject CartState Cart
@inject AppContextState Sim
@inject AuthSessionState Auth
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DeliveryApp Blazor</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="session-box px-3">
            @if (Auth.IsAuthenticated)
            {
                <div><strong>@Auth.DisplayName</strong></div>
                <div>@Auth.Email</div>
                <div><strong>Role:</strong> @Auth.Role</div>
                @if (Auth.CustomerId.HasValue)
                {
                    <div><strong>Customer:</strong> #@Auth.CustomerId</div>
                }
                @if (Auth.CourierId.HasValue)
                {
                    <div><strong>Courier:</strong> #@Auth.CourierId</div>
                }
                <button class="btn btn-logout" @onclick="Logout">Deconnexion</button>
            }
            else
            {
                <div>Aucune session active</div>
                <a class="btn btn-logout" href="/account">Connexion</a>
            }
        </div>

        @if (Auth.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="nav-ico">Home</span>
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="account">
                <span class="nav-ico">Connexion</span>
            </NavLink>
        </div>

        @if (Auth.IsInRole(AppRoleCode.Customer))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="stores">
                    <span class="nav-ico">Stores</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="my-orders">
                    <span class="nav-ico">Mes commandes</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="cart">
                    <span class="nav-ico">Panier (@Cart.TotalItems)</span>
                </NavLink>
            </div>
        }

        @if (Auth.IsInRole(AppRoleCode.Courier))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders/board">
                    <span class="nav-ico">Operations commandes</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders">
                    <span class="nav-ico">Rechercher commande</span>
                </NavLink>
            </div>
        }

        @if (Auth.IsInRole(AppRoleCode.Admin))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">
                    <span class="nav-ico">Administration</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dashboard">
                    <span class="nav-ico">Dashboard</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Cart.Changed += OnCartChanged;
        Sim.Changed += OnContextChanged;
        Auth.Changed += OnAuthChanged;
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void OnContextChanged() => InvokeAsync(StateHasChanged);

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        Cart.Clear();
        Sim.Reset();
        Auth.SignOut();
        Navigation.NavigateTo("/account", forceLoad: false);
    }

    public void Dispose()
    {
        Cart.Changed -= OnCartChanged;
        Sim.Changed -= OnContextChanged;
        Auth.Changed -= OnAuthChanged;
    }
}
